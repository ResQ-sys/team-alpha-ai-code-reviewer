# Choose which Code-LLM backend the agents use: ollama | anthropic | openai | gemini | local_hf
# (also switchable at runtime from the Streamlit sidebar)
LLM_PROVIDER=ollama

# Number of concurrent LLM calls in the review / fix-generation nodes. Hosted
# APIs handle high concurrency well; a small local Ollama may need this at 1-2.
MAX_LLM_WORKERS=4

# --- ollama backend (local, no API key; run `ollama serve` + `ollama pull qwen2.5-coder:1.5b`) ---
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b

# --- secure-coding RAG (also toggleable from the Streamlit sidebar) ---
USE_RAG=true

# --- Redis LLM-response cache (falls back to embedded redislite, then no-op) ---
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=604800

# --- anthropic backend ---
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- openai backend ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- gemini backend (Google AI Studio key: https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- grok / xAI backend (OpenAI-compatible; key: https://console.x.ai) ---
XAI_API_KEY=your-xai-api-key
GROK_MODEL=grok-3
# XAI_BASE_URL=https://api.x.ai/v1

# --- local_hf backend (Code Llama / DeepSeek-Coder / StarCoder / Qwen2.5-Coder
#     served locally via vLLM / TGI / Ollama behind a simple HTTP wrapper) ---
LOCAL_HF_ENDPOINT=http://localhost:8001/generate
LOCAL_HF_MODEL_NAME=deepseek-ai/deepseek-coder-6.7b-instruct

# Embedding model for the secure-coding RAG index (falls back to TF-IDF
# automatically if this can't be downloaded, e.g. no internet access)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
